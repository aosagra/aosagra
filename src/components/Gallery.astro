---
import Icon from "./Icon.astro";
import { galleryImages } from "../data/site";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const images = typeof limit === "number" ? galleryImages.slice(0, limit) : galleryImages;
const agraMovesBetterAlbumUrl = "https://photos.app.goo.gl/UAuHjvHWGDvw2XKM7";
const galleryGroups =
  typeof limit === "number"
    ? [
        {
          id: "selected",
          title: "Selected photographs",
          description: "AOS photographs selected for this page.",
          images
        }
      ]
    : [
        {
          id: "aos-foundation-day-november-2026",
          title: "1 November AOS Foundation Day",
          description: "Selected photographs from the scientific programme, Memorial Orations, Foundation Day ceremony, Lifetime Achievement Awards and fellowship.",
          images: images.filter((image) => image.src.includes("/aos-foundation-day-november-2026/"))
        },
        {
          id: "aos-ai-workshop-october-2026",
          title: "25 October Hands-on AI Workshop",
          description: "Photographs from the practical AI workshop for orthopaedicians conducted with Dr Anubha Karol and supported by Sun Pharma.",
          images: images.filter((image) => image.src.includes("/aos-ai-workshop-october-2026/"))
        },
        {
          id: "agra-moves-better-closing-august-2026",
          title: "30 August Agra Moves Better Closing",
          description: "Selected photographs from the Agra Moves Better - 2026 closing ceremony and partner recognition programme.",
          images: images.filter((image) => image.src.includes("/agra-moves-better-closing-august-2026/"))
        },
        {
          id: "agra-moves-better-media-coverage-august-2026",
          title: "Agra Moves Better Media Coverage & Newspaper Cuttings",
          description: "Selected newspaper cuttings, press coverage and approved campaign graphics kept separately from programme photographs.",
          images: images.filter((image) => image.src.includes("/agra-moves-better-media-coverage-august-2026/"))
        },
        {
          id: "multi-site-bone-health-august-2026",
          title: "27 August Four-Site Bone-Health Outreach",
          description: "Selected photographs from the medical college, cancer-care, school and community BMD awareness outreach.",
          images: images.filter((image) => image.src.includes("/multi-site-bone-health-august-2026/"))
        },
        {
          id: "air-force-airport-awareness-august-2026",
          title: "25 August Air Force & Airport Outreach",
          description: "Selected photographs and programme material from the Air Force Station Agra and Agra Airport BMD, ergonomics and CPR awareness activity.",
          images: images.filter((image) => image.src.includes("/air-force-airport-awareness-august-2026/"))
        },
        {
          id: "sports-jail-community-outreach-august-2026",
          title: "22-23 August Sports, District Jail & Community Outreach",
          description: "Selected photographs from the Prakhar Badminton Academy, District Jail Agra and community BMD outreach activities.",
          images: images.filter((image) => image.src.includes("/sports-jail-community-outreach-august-2026/"))
        },
        {
          id: "school-bone-health-august-2026",
          title: "24 August School & Women’s Bone-Health",
          description: "Selected photographs from the Chandrawati Kanya Vidyalaya school and women’s bone-health awareness programme.",
          images: images.filter((image) => image.src.includes("/school-bone-health-august-2026/"))
        },
        {
          id: "independence-day-workplace-outreach-august-2026",
          title: "15-21 August Independence Day & Workplace Outreach",
          description: "Selected photographs from the Independence Day, transport, workplace, hospital and women’s bone-health outreach cluster.",
          images: images.filter((image) => image.src.includes("/independence-day-workplace-outreach-august-2026/"))
        },
        {
          id: "community-bone-health-august-2026",
          title: "6 August Community Bone-Health Outreach",
          description: "Selected photographs from Agra Moves Better - 2026 community BMD screening, counselling and awareness outreach with local women’s and service organisations.",
          images: images.filter((image) => image.src.includes("/community-bone-health-august-2026/"))
        },
        {
          id: "agra-moves-better-august-2026",
          title: "1 August Agra Moves Better Launch",
          description: "Selected photographs from the Agra Moves Better - 2026 launch and Media, NGO & Founding Partners' Meet.",
          images: images.filter((image) => image.src.includes("/agra-moves-better-august-2026/"))
        },
        {
          id: "gbm-august-2026",
          title: "1 August GBM & Scientific Programme",
          description: "Photographs from the AOS General Body Meeting, scientific session, and Agra Moves Better/Bone & Joint Week planning discussion.",
          images: images.filter((image) => image.src.includes("/gbm-august-2026/"))
        },
        {
          id: "police-ergonomics-august-2026",
          title: "4 August Police Workplace Ergonomics",
          description: "Photographs from the National Bone & Joint Day CPR awareness and Police Workplace Ergonomics programme under Agra Moves Better - 2026.",
          images: images.filter((image) => image.src.includes("/police-ergonomics-august-2026/"))
        },
        {
          id: "police-wellness-august-2026",
          title: "2 August Police Wellness & Family Health Camp",
          description: "Photographs and media record from the Agra Moves Better - 2026 public-awareness camp at Police Lines.",
          images: images.filter((image) => image.src.includes("/police-wellness-august-2026/"))
        },
        {
          id: "executive-meeting-july-2026",
          title: "18 July Executive Meeting",
          description: "Photographs from the Executive Committee meeting and short academic session.",
          images: images.filter((image) => image.src.includes("/executive-meeting-july-2026/"))
        },
        {
          id: "pg-academic-series-2026",
          title: "16 July PG Academic Series",
          description: "Photographs and programme material from the first inter-college postgraduate paper presentation competition.",
          images: images.filter((image) => image.src.includes("/pg-academic-series-july-2026/"))
        },
        {
          id: "osteoporosis-sarcopenia-2026",
          title: "11 July Osteoporosis & Sarcopenia Symposium",
          description: "Photographs from the 11 July 2026 AOS academic programme.",
          images: images.filter((image) => image.src.includes("/osteoporosis-sarcopenia-july-2026/"))
        },
        {
          id: "gbm-july-2026",
          title: "July GBM & Scientific Session",
          description: "Photographs from the July 2026 general body and scientific meeting.",
          images: images.filter((image) => image.src.includes("/gbm-july-2026/"))
        },
        {
          id: "yoga-day-june-2026",
          title: "21 June Yoga Day Programme",
          description: "Programme material from the AOS International Yoga Day activity.",
          images: images.filter((image) => image.src.includes("/yoga-day-june-2026/"))
        },
        {
          id: "extended-executive-june-2026",
          title: "4 June Academic Journal Club & Extended Executive Meeting",
          description: "Photographs from the first formal academic and extended executive meeting of the new cabinet.",
          images: images.filter((image) => image.src.includes("/extended-executive-june-2026/"))
        },
        {
          id: "clubfoot-awareness-june-2026",
          title: "3 June Clubfoot Awareness Programme",
          description: "Public-awareness photographs and material from World Clubfoot Day 2026.",
          images: images.filter((image) => image.src.includes("/clubfoot-awareness-june-2026/"))
        },
        {
          id: "installation-ceremony-2026",
          title: "27 May Installation Ceremony",
          description: "Selected material from the installation ceremony for AOS office bearers 2026-27.",
          images: images.filter((image) => image.src.includes("/installation-ceremony-2026/"))
        },
        {
          id: "aos-archive",
          title: "AOS archive photographs",
          description: "Earlier AOS activity photographs preserved from the website archive.",
          images: images.filter(
            (image) =>
              !image.src.includes("/aos-foundation-day-november-2026/") &&
              !image.src.includes("/aos-ai-workshop-october-2026/") &&
              !image.src.includes("/agra-moves-better-closing-august-2026/") &&
              !image.src.includes("/agra-moves-better-media-coverage-august-2026/") &&
              !image.src.includes("/multi-site-bone-health-august-2026/") &&
              !image.src.includes("/air-force-airport-awareness-august-2026/") &&
              !image.src.includes("/sports-jail-community-outreach-august-2026/") &&
              !image.src.includes("/school-bone-health-august-2026/") &&
              !image.src.includes("/independence-day-workplace-outreach-august-2026/") &&
              !image.src.includes("/community-bone-health-august-2026/") &&
              !image.src.includes("/agra-moves-better-august-2026/") &&
              !image.src.includes("/gbm-august-2026/") &&
              !image.src.includes("/police-ergonomics-august-2026/") &&
              !image.src.includes("/police-wellness-august-2026/") &&
              !image.src.includes("/osteoporosis-sarcopenia-july-2026/") &&
              !image.src.includes("/pg-academic-series-july-2026/") &&
              !image.src.includes("/executive-meeting-july-2026/") &&
              !image.src.includes("/gbm-july-2026/") &&
              !image.src.includes("/yoga-day-june-2026/") &&
              !image.src.includes("/extended-executive-june-2026/") &&
              !image.src.includes("/clubfoot-awareness-june-2026/") &&
              !image.src.includes("/installation-ceremony-2026/")
          )
        }
      ].filter((group) => group.images.length > 0);
---

{
  typeof limit !== "number" && (
    <>
      <section class="gallery-live-album" id="agra-moves-better-live-album" aria-labelledby="agra-moves-better-live-album-heading">
        <div class="gallery-live-album__icon">
          <Icon name="image" size={23} />
        </div>
        <div>
          <p>Live campaign album</p>
          <h3 id="agra-moves-better-live-album-heading">Agra Moves Better 2026 photographs</h3>
          <span>
            New photographs from the ongoing Agra Moves Better campaign are being maintained in the shared AOS album.
          </span>
        </div>
        <a class="text-link" href={agraMovesBetterAlbumUrl} target="_blank" rel="noreferrer">
          Open live album <Icon name="external" size={16} />
        </a>
      </section>

      <nav class="gallery-jump" aria-label="Gallery groups">
        {galleryGroups.map((group) => (
          <a href={`#${group.id}`}>
            <strong>{group.title}</strong>
            <span>{group.images.length} photographs</span>
          </a>
        ))}
      </nav>
    </>
  )
}

<div class="gallery-collection" data-gallery>
  {
    galleryGroups.map((group) => (
      <section class="gallery-section" id={group.id} aria-labelledby={`${group.id}-heading`}>
        {typeof limit !== "number" && (
          <div class="gallery-section__head">
            <div>
              <h3 id={`${group.id}-heading`}>{group.title}</h3>
              <p>{group.description}</p>
            </div>
            <span>{group.images.length} photos</span>
          </div>
        )}

        <div class="gallery-grid">
          {group.images.map((image, index) => (
            <button
              id={image.id}
              class:list={["gallery-item", { "gallery-item--wide": index === 0 || index === 5 }]}
              type="button"
              data-gallery-item
              data-src={image.src}
              data-alt={image.alt}
              data-caption={image.caption}
              aria-label={`Open image ${index + 1} in ${group.title}: ${image.alt}`}
            >
              <img src={image.src} alt={image.alt} width="897" height="598" loading={index > 2 ? "lazy" : "eager"} />
              <span><Icon name="image" size={17} /> View photograph</span>
            </button>
          ))}
        </div>
      </section>
    ))
  }
</div>

<dialog class="lightbox" data-lightbox aria-label="Photograph preview">
  <button class="lightbox__close" type="button" data-lightbox-close>
    <span class="sr-only">Close image preview</span>
    <Icon name="close" size={23} />
  </button>
  <img data-lightbox-image src="/assets/optimized/gallery/aos-activity-01.webp" alt="" />
  <p data-lightbox-caption></p>
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const lightboxCaption = lightbox?.querySelector<HTMLElement>("[data-lightbox-caption]");

  document.querySelectorAll<HTMLButtonElement>("[data-gallery-item]").forEach((item) => {
    item.addEventListener("click", () => {
      if (!lightbox || !lightboxImage || !lightboxCaption) return;
      lightboxImage.src = item.dataset.src ?? "";
      lightboxImage.alt = item.dataset.alt ?? "";
      lightboxCaption.textContent = item.dataset.caption || item.dataset.alt || "";
      lightbox.showModal();
    });
  });

  lightbox?.querySelector("[data-lightbox-close]")?.addEventListener("click", () => lightbox.close());
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>
